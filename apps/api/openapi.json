                      "NEVER_MARRIED",
                      "DIVORCED",
                      "WIDOWED",
                      "AWAITING_DIVORCE"
                    ],
                    "default": "NEVER_MARRIED"
                  },
                  "religion": {
                    "type": "string",
                    "enum": [
                      "HINDU",
                      "CHRISTIAN",
                      "MUSLIM",
                      "JAIN",
                      "SIKH",
                      "BUDDHIST",
                      "OTHER",
                      "NONE"
                    ]
                  },
                  "community": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "star": {
                    "type": "string",
                    "enum": [
                      "ASWATHY",
                      "BHARANI",
                      "KARTHIKA",
                      "ROHINI",
                      "MAKAYIRAM",
                      "THIRUVATHIRA",
                      "PUNARTHAM",
                      "POOYAM",
                      "AYILYAM",
                      "MAKAM",
                      "POORAM",
                      "UTHRAM",
                      "ATHAM",
                      "CHITHIRA",
                      "CHOTHI",
                      "VISAKHAM",
                      "ANIZHAM",
                      "THRIKKETTA",
                      "MOOLAM",
                      "POORADAM",
                      "UTHRADAM",
                      "THIRUVONAM",
                      "AVITTAM",
                      "CHATHAYAM",
                      "POORURUTTATHI",
                      "UTHRATTATHI",
                      "REVATHI"
                    ]
                  },
                  "nativeDistrict": {
                    "type": "string",
                    "enum": [
                      "THIRUVANANTHAPURAM",
                      "KOLLAM",
                      "PATHANAMTHITTA",
                      "ALAPPUZHA",
                      "KOTTAYAM",
                      "IDUKKI",
                      "ERNAKULAM",
                      "THRISSUR",
                      "PALAKKAD",
                      "MALAPPURAM",
                      "KOZHIKODE",
                      "WAYANAD",
                      "KANNUR",
                      "KASARAGOD"
                    ]
                  },
                  "currentCountry": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2,
                    "description": "ISO 3166-1 alpha-2"
                  },
                  "currentCity": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "heightCm": {
                    "type": "integer",
                    "minimum": 120,
                    "maximum": 230
                  },
                  "education": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "occupation": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "about": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "createdAs": {
                    "type": "string",
                    "enum": [
                      "SELF",
                      "MOTHER",
                      "FATHER",
                      "BROTHER",
                      "SISTER",
                      "GUARDIAN"
                    ]
                  }
                },
                "required": [
                  "fullName",
                  "gender",
                  "dateOfBirth",
                  "religion",
                  "currentCountry",
                  "createdAs"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
